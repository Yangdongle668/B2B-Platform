{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inquiry站点设置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assignment": {
      "type": "object",
      "title": "默认分配",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "defaultUserId",
        "escalationUserId"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1,
          "title": "结构版本"
        },
        "defaultUserId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "默认负责人"
        },
        "escalationUserId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "升级负责人"
        }
      },
      "default": {
        "schemaVersion": 1,
        "defaultUserId": null,
        "escalationUserId": null
      }
    },
    "messageTranslation": {
      "type": "object",
      "title": "留言翻译",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enabled"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1,
          "title": "结构版本"
        },
        "enabled": {
          "type": "boolean",
          "title": "启用留言翻译"
        }
      },
      "default": {
        "schemaVersion": 1,
        "enabled": false
      }
    },
    "retention": {
      "type": "object",
      "title": "保留期限",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "closedYears",
        "spamDays"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1,
          "title": "结构版本"
        },
        "closedYears": {
          "type": "integer",
          "minimum": 1,
          "title": "已关闭询盘保留年数"
        },
        "spamDays": {
          "type": "integer",
          "minimum": 1,
          "title": "垃圾询盘保留天数"
        }
      },
      "default": {
        "schemaVersion": 1,
        "closedYears": 3,
        "spamDays": 30
      }
    }
  }
}
