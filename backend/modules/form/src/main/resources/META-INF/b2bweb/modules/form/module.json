{
  "id": "form",
  "name": "表单",
  "version": "1.0.0",
  "layer": "L2",
  "platform": ">=1.0.0 <2.0.0",
  "requires": {
    "media": "^1.0",
    "notification": "^1.0"
  },
  "optional": {},
  "disableable": true,
  "tablePrefix": "frm_",
  "apiPrefix": "form",
  "permissions": [
    {
      "code": "form:form:view",
      "name": "查看表单"
    },
    {
      "code": "form:form:manage",
      "name": "管理表单"
    },
    {
      "code": "form:submission:view",
      "name": "查看提交记录"
    },
    {
      "code": "form:blocklist:manage",
      "name": "管理黑名单"
    }
  ],
  "menus": [
    {
      "key": "form",
      "name": "表单",
      "parent": "settings",
      "route": "/form/forms",
      "permission": "form:form:view",
      "order": 100
    }
  ],
  "settings": "settings.schema.json",
  "components": [],
  "events": {
    "publishes": [
      "FormSubmittedEvent",
      "FormChangedEvent",
      "TranslatableResourceChangedEvent"
    ],
    "subscribes": [
      "ContentUnpublishedEvent",
      "ContentPurgedEvent",
      "SiteSettingsChangedEvent"
    ]
  }
}
