    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$media"
      ],
      "x-translatable": false,
      "properties": {
        "$media": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "x-translatable": false
        }
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$content"
      ],
      "x-translatable": false,
      "properties": {
        "$content": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "x-translatable": false
        }
      }
    },
    "termRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$term"
      ],
      "x-translatable": false,
      "properties": {
        "$term": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "x-translatable": false
        }
      }
    },
    "link": {
      "oneOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^https?://(?![^/?#]*@)[^/\\s?#]+(?:[/?#]|$)",
              "x-translatable": false
            },
            "rel": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "nofollow",
                  "sponsored"
                ]
              }
            }
          }
        }
      ],
      "x-translatable": false
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
