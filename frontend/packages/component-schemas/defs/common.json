          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "params": {
              "type": "object"
            }
          }
        }
      }
    },
    "styleValue": {
      "enum": [
        "default",
        "panel",
        "ink",
        "none",
        "small",
        "medium",
        "large",
        "full",
        "wide",
        "narrow"
      ],
      "x-translatable": false
    }
  }
