          "enum": [
            "doc",
            "text",
            "heading",
            "hardBreak",
            "horizontalRule",
            "paragraph",
            "bulletList",
            "orderedList",
            "listItem",
            "blockquote",
            "codeBlock",
            "table",
            "tableRow",
            "tableCell",
            "tableHeader",
            "image",
            "video",
            "alert",
            "productCard",
            "cta"
          ]
        },
        "text": {
          "type": "string"
        },
        "attrs": {
          "type": "object"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richNode"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "code",
                  "link"
                ]
              },
              "attrs": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "richText": {
      "allOf": [
        {
          "$ref": "#/$defs/richNode"
        },
        {
          "properties": {
            "type": {
              "const": "doc"
            }
          },
          "type": "object"
        }
      ],
      "x-translatable": true
    },
    "richTextInline": {
      "allOf": [
        {
          "$ref": "#/$defs/richNode"
        },
        {
          "properties": {
            "type": {
              "const": "doc"
            },
            "content": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "properties": {
