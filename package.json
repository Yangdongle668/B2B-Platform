{
  "name": "b2b-platform",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "lint": "eslint frontend tools/frontend && stylelint \"frontend/**/*.{css,vue}\" && node tools/frontend/lint.mjs && node tools/frontend/modules.mjs && pnpm check:schemas",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && pnpm --filter @b2bweb/admin typecheck && pnpm --filter @b2bweb/website typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @b2bweb/admin build && pnpm --filter @b2bweb/website build",
    "generate:client": "openapi-typescript frontend/packages/api-client/openapi.json -o frontend/packages/api-client/src/schema.d.ts",
    "check:schemas": "node frontend/packages/component-schemas/scripts/check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "axe-core": "4.10.3",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.13",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-vue": "10.11.1",
    "vue-eslint-parser": "10.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "stylelint": "17.16.0",
    "postcss-html": "2.0.0",
    "postcss": "8.5.8"
  }
}
